# Usually NOT needed for local development: the app automatically uses the
# address of the computer running `npx expo start` (port 5000), which works for
# simulators, emulators AND physical phones on the same Wi-Fi.
#
# Set it only to point at a different backend (e.g. staging/production), or when
# using `expo start --tunnel`. Never put secrets in EXPO_PUBLIC_* variables —
# they are embedded in the app bundle.
# EXPO_PUBLIC_API_URL=https://your-api-domain.com/api
