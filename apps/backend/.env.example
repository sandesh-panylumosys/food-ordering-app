# NOTE: wrap any value containing '#', spaces or quotes in double quotes,
# e.g. SEED_ADMIN_PASSWORD="p@ss#word" — otherwise everything after '#' is dropped.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (admin panel URLs).
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind a reverse proxy (Render, Railway, Fly.io, ALB).
TRUST_PROXY=0

# ─── Supabase (backend only — NEVER expose the service role key) ────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct Postgres URI, only needed for `pnpm db:migrate`.
# Supabase → Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Razorpay (use rzp_test_ keys locally) ──────────────────────────────────
# Payment gateway: razorpay | mock. `mock` simulates payments for LOCAL DEVELOPMENT
# only (no Razorpay account needed); the API refuses to start with it in production.
PAYMENT_PROVIDER=razorpay
# Only for a demo/staging SERVER (NODE_ENV=production) without Razorpay: set to true
# to allow PAYMENT_PROVIDER=mock. Never on a server real customers use.
ALLOW_MOCK_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: secret configured on the Razorpay webhook → /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ─── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ember-oak

# ─── Seed (pnpm db:seed) ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@emberandoak.cafe
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Café Admin
