# ─────────────────────────────────────────────────────────────────────────────
# Reference of every environment variable in the monorepo.
# Each app reads its own file:
#   apps/backend/.env   ← copy from apps/backend/.env.example (SECRETS live here only)
#   apps/mobile/.env    ← EXPO_PUBLIC_API_URL only
#   apps/admin/.env     ← VITE_API_URL only
# Wrap values containing '#' or spaces in double quotes.
# ─────────────────────────────────────────────────────────────────────────────

# Backend
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Supabase (backend only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# JWT (backend only)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay (backend only)
# Payment gateway: razorpay | mock. `mock` simulates payments for LOCAL DEVELOPMENT
# only (no Razorpay account needed); the API refuses to start with it in production.
PAYMENT_PROVIDER=razorpay
# Only for a demo/staging SERVER (NODE_ENV=production) without Razorpay: set to true
# to allow PAYMENT_PROVIDER=mock. Never on a server real customers use.
ALLOW_MOCK_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (backend only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ember-oak

# Seed
SEED_ADMIN_EMAIL=admin@emberandoak.cafe
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Café Admin

# Mobile (public — bundled into the app)
EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api

# Admin (public — bundled into the web app)
VITE_API_URL=http://localhost:5000/api
