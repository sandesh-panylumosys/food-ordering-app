{
  "name": "food-ordering-app",
  "private": true,
  "version": "1.0.0",
  "description": "Ember & Oak — premium café ordering platform (Expo + Express + Supabase + Razorpay + Cloudinary)",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter admin --filter mobile dev",
    "dev:api": "pnpm --filter backend dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "build": "pnpm --filter backend --filter admin build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "e2e": "pnpm --filter backend e2e"
  }
}
